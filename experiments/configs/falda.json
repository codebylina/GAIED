{
  "name": "falda",
  "description": "FALDA baseline: 4 agents (two pairs share a seed), fixed budget of 10 iterations per agent, one repetition.",
  "seeds": ["CNC(N)=O", "CNC(N)=O", "CC1=C(O)N=C(O)N1", "CC1=C(O)N=C(O)N1"],
  "max_iterations": 10,
  "repetitions": 1,
  "timeout_min": 210,
  "conditions": ["falda"],
  "env": {
    "NO_IMPROVEMENT_TOLERANCE": "0",
    "STABLE_REPORTS": "100000",
    "GOAL_MAX_HEAVY_ATOMS": "12",
    "GOAL_ALLOWED_ELEMENTS": "C,H,N,O,F",
    "N_XTB_WORKERS": "2"
  }
}
